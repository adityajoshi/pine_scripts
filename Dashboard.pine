//@version=6
indicator("Dashboard", overlay = true)

// --- Inputs ---
rsiLength = input.int(14, "RSI Length", minval = 1)
rsiSource = input.source(close, "Source")
tablePos  = input.string(position.top_right, "Table Position", 
             options = [position.top_right, position.bottom_right, position.top_left, position.bottom_left])

// --- Calculations ---
rsiValueMonthly = request.security(syminfo.tickerid, "1M", ta.rsi(rsiSource, rsiLength))
rsiValueWeekly  = request.security(syminfo.tickerid, "1W", ta.rsi(rsiSource, rsiLength))
rsiValueDaily   = request.security(syminfo.tickerid, "1D", ta.rsi(rsiSource, rsiLength))

// --- Table Logic ---
var table dashboard = table.new(tablePos, 2, 4,
     frame_color = color.gray, 
     frame_width = 1, 
     border_color = color.gray, 
     border_width = 1)

// Update table only on the last bar to save resources
if barstate.islast
    // Header
    table.cell(dashboard, 0, 0, "Timeframe",     bgcolor = color.new(color.gray, 70), text_color = color.white)
    table.cell(dashboard, 1, 0, "RSI (" + str.tostring(rsiLength) + ")", bgcolor = color.new(color.gray, 70), text_color = color.white)
    
    // Monthly Data
    color rsiColorMonthly = rsiValueMonthly >= 70 ? color.red : rsiValueMonthly <= 30 ? color.green : color.white
    table.cell(dashboard, 0, 1, "Monthly", bgcolor = color.new(color.black, 20), text_color = color.white)
    table.cell(dashboard, 1, 1, str.tostring(rsiValueMonthly, "#.##"), bgcolor = color.new(color.black, 20), text_color = rsiColorMonthly)

    // Weekly Data
    color rsiColorWeekly = rsiValueWeekly >= 70 ? color.red : rsiValueWeekly <= 30 ? color.green : color.white
    table.cell(dashboard, 0, 2, "Weekly", bgcolor = color.new(color.black, 20), text_color = color.white)
    table.cell(dashboard, 1, 2, str.tostring(rsiValueWeekly, "#.##"), bgcolor = color.new(color.black, 20), text_color = rsiColorWeekly)

    // Daily Data
    color rsiColorDaily = rsiValueDaily >= 70 ? color.red : rsiValueDaily <= 30 ? color.green : color.white
    table.cell(dashboard, 0, 3, "Daily", bgcolor = color.new(color.black, 20), text_color = color.white)
    table.cell(dashboard, 1, 3, str.tostring(rsiValueDaily, "#.##"), bgcolor = color.new(color.black, 20), text_color = rsiColorDaily)
